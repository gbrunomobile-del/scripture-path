{
  "expo": {
    "name": "Manna: Daily Word",
    "slug": "scripture-path",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "mannadailyword",
    "splash": {
      "backgroundColor": "#060810"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scripturepath.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060810"
      },
      "package": "com.scripturepath.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "36e64c67-be88-4250-b108-bcd2318475c8"
      }
    }
  }
}
